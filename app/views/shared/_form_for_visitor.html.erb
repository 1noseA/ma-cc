<dialog
  data-controller="form-modal"
  data-action="click->form-modal#backdropClick"
  class="rounded-2xl shadow-2xl p-0 border-0 backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm"
  style="width: min(90vw, 28rem); position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); margin: 0; padding: 0;">

  <div style="padding: 1.75rem 1.75rem 1.5rem;">
    <%# ── Header ── %>
    <div class="flex items-start justify-between mb-5">
      <div>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold tracking-widest text-sky-600 bg-sky-50 uppercase mb-2">Contact</span>
        <h2 class="font-semibold text-xl text-slate-900">お問い合わせ</h2>
      </div>
      <button
        type="button"
        data-action="form-modal#close"
        class="text-slate-400 hover:text-slate-600 transition-colors duration-150 mt-0.5 p-1 rounded hover:bg-slate-100 cursor-pointer"
        aria-label="閉じる">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <p class="text-slate-500 text-sm mb-5">資料請求やご質問はこちらからお気軽にどうぞ。</p>

    <%# ── Form ── %>
    <%= form_with scope: :form_submission, url: form_submissions_path(@current_form), method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, "お名前", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
        <%= f.text_field :name,
              placeholder: "山田 太郎",
              class: "block w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm
                      focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent
                      placeholder:text-slate-300 transition duration-150" %>
      </div>
      <div>
        <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
        <%= f.email_field :email,
              placeholder: "you@example.com",
              class: "block w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm
                      focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent
                      placeholder:text-slate-300 transition duration-150" %>
      </div>
      <div class="pt-1">
        <%= f.submit "送信する",
              class: "w-full bg-sky-700 text-white text-sm font-semibold py-3 rounded-lg
                      hover:bg-sky-800 transition-colors duration-150 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</dialog>

<style>
  dialog[open] {
    animation: fadeSlideUp 0.25s ease-out;
    background: white;
  }
  dialog::backdrop {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(2px);
  }
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translate(-50%, calc(-50% + 10px)); }
    to   { opacity: 1; transform: translate(-50%, -50%); }
  }
</style>
