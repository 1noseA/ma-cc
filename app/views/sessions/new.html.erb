<div class="min-h-[80vh] flex items-center justify-center">
  <div class="w-full max-w-sm">
    <%# Logo %>
    <div class="flex items-center gap-2.5 mb-8">
      <div class="w-8 h-8 bg-sky-600 rounded-md flex items-center justify-center shrink-0">
        <svg class="w-4.5 h-4.5 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
        </svg>
      </div>
      <div>
        <p class="text-slate-900 text-sm font-semibold leading-tight">Leadpulse</p>
        <p class="text-sky-600 text-xs leading-tight font-medium">Admin</p>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-8">
      <h1 class="text-xl font-bold text-slate-900 mb-6">ログイン</h1>

      <%= form_with url: session_url, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :email_address, "メールアドレス", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= form.email_field :email_address,
                required: true,
                autofocus: true,
                autocomplete: "username",
                value: params[:email_address],
                class: "block w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm
                        focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent
                        transition duration-150" %>
        </div>

        <div>
          <%= form.label :password, "パスワード", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= form.password_field :password,
                required: true,
                autocomplete: "current-password",
                maxlength: 72,
                class: "block w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm
                        focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent
                        transition duration-150" %>
        </div>

        <div class="pt-1">
          <%= form.submit "ログイン",
                class: "w-full bg-sky-700 text-white text-sm font-semibold py-2.5 rounded-lg
                        hover:bg-sky-800 transition-colors duration-150 cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-4 text-center">
        <%= link_to "パスワードを忘れた方", new_password_path, class: "text-xs text-slate-400 hover:text-slate-600 transition-colors duration-150" %>
      </div>
    </div>

    <div class="mt-4 border border-dashed border-slate-300 rounded-lg p-4">
      <%= link_to "/dev/login",
            class: "block w-full text-center bg-slate-100 hover:bg-slate-200 text-slate-600 text-sm font-medium py-2.5 rounded-lg transition-colors duration-150 cursor-pointer" do %>
        テストログイン
      <% end %>
    </div>
  </div>
</div>
