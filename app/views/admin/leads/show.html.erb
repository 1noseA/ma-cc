<% content_for :title, "#{@lead.name} - リード詳細" %>

<div class="mb-6">
  <%= link_to admin_leads_path,
        class: "inline-flex items-center gap-1.5 text-slate-400 hover:text-slate-700 text-sm font-medium transition-colors duration-150" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
    </svg>
    リード一覧
  <% end %>
</div>

<%# ── Lead profile ── %>
<div class="bg-white rounded-xl border border-slate-200 p-6 mb-6">
  <div class="flex items-start justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @lead.name %></h2>
      <p class="text-slate-500 text-sm mt-0.5"><%= @lead.email %></p>
    </div>
    <div class="text-right">
      <p class="text-xs font-medium text-slate-400 uppercase tracking-wide mb-1">スコア</p>
      <p class="text-3xl font-bold text-sky-700"><%= @lead.visitor.score %></p>
    </div>
  </div>
  <div class="mt-4 pt-4 border-t border-slate-100 flex gap-6 text-sm">
    <div>
      <p class="text-xs text-slate-400 mb-0.5">リード化日時</p>
      <p class="text-slate-700 font-medium"><%= @lead.first_converted_at.strftime("%Y/%m/%d %H:%M") %></p>
    </div>
    <div>
      <p class="text-xs text-slate-400 mb-0.5">PV数</p>
      <p class="text-slate-700 font-medium"><%= @lead.visitor.page_view_count %></p>
    </div>
  </div>
</div>

<%# ── Action history ── %>
<div class="bg-white rounded-xl border border-slate-200 overflow-hidden mb-6">
  <div class="px-6 py-4 border-b border-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">行動履歴</h3>
  </div>
  <% events = @lead.visitor.events.sort_by(&:occurred_at).reverse %>
  <% if events.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-100 bg-slate-50">
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">種別</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">パス</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">日時</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% events.each do |event| %>
          <tr class="hover:bg-slate-50 transition-colors duration-100">
            <td class="px-6 py-3">
              <% if event.event_type == "form_submit" %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-sky-50 text-sky-700 border border-sky-200">form_submit</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">page_view</span>
              <% end %>
            </td>
            <td class="px-6 py-3 font-mono text-xs text-slate-600"><%= event.path %></td>
            <td class="px-6 py-3 text-slate-400 text-xs"><%= event.occurred_at.strftime("%Y/%m/%d %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="px-6 py-8 text-center text-slate-400 text-sm">行動履歴はありません。</div>
  <% end %>
</div>

<%# ── Form submissions ── %>
<div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-200">
    <h3 class="text-sm font-semibold text-slate-900">フォーム送信履歴</h3>
  </div>
  <% submissions = @lead.visitor.form_submissions.sort_by { |s| s.submitted_at || Time.at(0) }.reverse %>
  <% if submissions.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-100 bg-slate-50">
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">メール</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">氏名</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">送信日時</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% submissions.each do |submission| %>
          <tr class="hover:bg-slate-50 transition-colors duration-100">
            <td class="px-6 py-3 text-slate-700"><%= submission.email %></td>
            <td class="px-6 py-3 text-slate-700"><%= submission.name %></td>
            <td class="px-6 py-3 text-slate-400 text-xs"><%= submission.submitted_at&.strftime("%Y/%m/%d %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="px-6 py-8 text-center text-slate-400 text-sm">送信履歴はありません。</div>
  <% end %>
</div>
