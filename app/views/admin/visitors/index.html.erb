<% content_for :title, "訪問者一覧" %>

<div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
    <h2 class="text-sm font-semibold text-slate-900">訪問者一覧</h2>
    <span class="text-xs text-slate-400"><%= @visitors.count %> 件</span>
  </div>

  <% if @visitors.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-100 bg-slate-50">
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">トークン</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">PV</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">スコア</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">最終訪問</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">状態</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @visitors.each do |visitor| %>
          <tr class="hover:bg-slate-50 transition-colors duration-100">
            <td class="px-6 py-3 font-mono text-xs text-slate-500 truncate max-w-[160px]">
              <%= visitor.visitor_token&.first(16) %>…
            </td>
            <td class="px-6 py-3 text-slate-700 font-medium"><%= visitor.page_view_count %></td>
            <td class="px-6 py-3">
              <span class="font-mono text-sm font-semibold text-slate-800"><%= visitor.score %></span>
            </td>
            <td class="px-6 py-3 text-slate-500 text-xs"><%= visitor.last_visited_at.strftime("%Y/%m/%d %H:%M") %></td>
            <td class="px-6 py-3">
              <% if visitor.lead.present? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-sky-50 text-sky-700 border border-sky-200">リード化済み</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-500">匿名</span>
              <% end %>
            </td>
            <td class="px-6 py-3 text-right">
              <%= link_to "詳細", admin_visitor_path(visitor), class: "text-sky-600 hover:text-sky-800 text-xs font-medium transition-colors duration-150" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="px-6 py-12 text-center text-slate-400 text-sm">訪問者はまだいません。</div>
  <% end %>
</div>
