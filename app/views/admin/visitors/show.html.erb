<% content_for :title, "訪問者詳細" %>

<div class="mb-6">
  <%= link_to admin_visitors_path,
        class: "inline-flex items-center gap-1.5 text-slate-400 hover:text-slate-700 text-sm font-medium transition-colors duration-150" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
    </svg>
    訪問者一覧
  <% end %>
</div>

<%# ── Visitor info ── %>
<div class="bg-white rounded-xl border border-slate-200 p-6 mb-6">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    <div>
      <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">スコア</p>
      <p class="text-2xl font-bold text-sky-700"><%= @visitor.score %></p>
    </div>
    <div>
      <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">PV数</p>
      <p class="text-2xl font-bold text-slate-800"><%= @visitor.page_view_count %></p>
    </div>
    <div>
      <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">初回訪問</p>
      <p class="text-sm font-medium text-slate-700"><%= @visitor.first_visited_at.strftime("%Y/%m/%d %H:%M") %></p>
    </div>
    <div>
      <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">最終訪問</p>
      <p class="text-sm font-medium text-slate-700"><%= @visitor.last_visited_at.strftime("%Y/%m/%d %H:%M") %></p>
    </div>
  </div>
  <div class="mt-4 pt-4 border-t border-slate-100">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">トークン</p>
    <p class="font-mono text-xs text-slate-400"><%= @visitor.visitor_token %></p>
  </div>
</div>

<%# ── Events ── %>
<div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-200">
    <h2 class="text-sm font-semibold text-slate-900">行動履歴</h2>
  </div>
  <% if @events.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-100 bg-slate-50">
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">日時</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">種別</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">パス</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @events.each do |event| %>
          <tr class="hover:bg-slate-50 transition-colors duration-100">
            <td class="px-6 py-3 text-slate-400 text-xs"><%= event.occurred_at.strftime("%Y/%m/%d %H:%M:%S") %></td>
            <td class="px-6 py-3">
              <% if event.event_type == "form_submit" %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-sky-50 text-sky-700 border border-sky-200">form_submit</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">page_view</span>
              <% end %>
            </td>
            <td class="px-6 py-3 font-mono text-xs text-slate-600"><%= event.path %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="px-6 py-10 text-center text-slate-400 text-sm">行動履歴はありません。</div>
  <% end %>
</div>
