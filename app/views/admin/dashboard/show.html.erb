<% content_for :title, "ダッシュボード" %>

<%# ── Stats ── %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
  <div class="bg-white rounded-xl border border-slate-200 p-6">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">訪問者数</p>
    <p class="text-3xl font-bold text-slate-900"><%= @visitor_count %></p>
    <p class="text-xs text-slate-400 mt-1">全期間</p>
  </div>
  <div class="bg-white rounded-xl border border-slate-200 p-6">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">リード数</p>
    <p class="text-3xl font-bold text-sky-700"><%= @lead_count %></p>
    <p class="text-xs text-slate-400 mt-1">全期間</p>
  </div>
  <div class="bg-white rounded-xl border border-slate-200 p-6">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2">コンバージョン率</p>
    <p class="text-3xl font-bold text-slate-900"><%= @conversion_rate %><span class="text-lg font-medium text-slate-400">%</span></p>
    <p class="text-xs text-slate-400 mt-1">訪問者 → リード</p>
  </div>
</div>

<%# ── Recent events ── %>
<div class="bg-white rounded-xl border border-slate-200">
  <div class="px-6 py-4 border-b border-slate-200">
    <h2 class="text-sm font-semibold text-slate-900">直近のイベント</h2>
  </div>
  <% if @recent_events.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-100">
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">種別</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">パス</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-500 uppercase tracking-wide">日時</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @recent_events.each do |event| %>
          <tr class="hover:bg-slate-50 transition-colors duration-100">
            <td class="px-6 py-3">
              <% if event.event_type == "form_submit" %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-sky-50 text-sky-700 border border-sky-200">form_submit</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">page_view</span>
              <% end %>
            </td>
            <td class="px-6 py-3 text-slate-600 font-mono text-xs"><%= event.path %></td>
            <td class="px-6 py-3 text-slate-400 text-xs"><%= event.occurred_at.strftime("%m/%d %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="px-6 py-10 text-center text-slate-400 text-sm">イベントはまだありません。</div>
  <% end %>
</div>
