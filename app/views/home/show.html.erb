<% content_for :title, "ホーム" %>

<%# ── Hero ── %>
<section class="py-20 lg:py-28">
  <div class="max-w-3xl">
    <h1 class="text-5xl lg:text-6xl font-bold text-slate-900 leading-[1.1] tracking-tight mb-6">
      行動を記録し、<br>リードを育てる。
    </h1>
    <p class="text-slate-500 text-lg leading-relaxed mb-10 max-w-2xl">
      訪問者がどのページを何回見たかを自動で記録し、興味が高まったタイミングでフォームを表示。
      問い合わせの獲得からリードの管理まで、これ一つで完結します。
    </p>
    <div class="flex items-center gap-4">
      <%= link_to articles_path,
            class: "inline-flex items-center gap-2 bg-sky-700 text-white text-sm font-semibold px-6 py-3 rounded-lg hover:bg-sky-800 transition-colors duration-150 cursor-pointer" do %>
        記事一覧を見る
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      <% end %>
      <%= link_to new_session_path, class: "text-sm font-medium text-slate-500 hover:text-slate-800 transition-colors duration-150" do %>
        管理画面 →
      <% end %>
    </div>
  </div>
</section>

<%# ── Feature cards ── %>
<section class="border-t border-slate-200 pt-16 pb-8">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-xl border border-slate-200 p-6 hover:shadow-md transition-shadow duration-200">
      <div class="w-9 h-9 bg-sky-50 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-5 h-5 text-sky-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-slate-900 mb-1.5">訪問者識別</h3>
      <p class="text-sm text-slate-500 leading-relaxed">Cookie で匿名訪問者を一意に識別し、セッションをまたいで行動を追跡します。</p>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 p-6 hover:shadow-md transition-shadow duration-200">
      <div class="w-9 h-9 bg-sky-50 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-5 h-5 text-sky-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-slate-900 mb-1.5">行動スコアリング</h3>
      <p class="text-sm text-slate-500 leading-relaxed">ページ閲覧やフォーム送信に応じてスコアを加算し、関心度を数値で可視化します。</p>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 p-6 hover:shadow-md transition-shadow duration-200">
      <div class="w-9 h-9 bg-sky-50 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-5 h-5 text-sky-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-slate-900 mb-1.5">条件付きフォーム表示</h3>
      <p class="text-sm text-slate-500 leading-relaxed">閾値を超えた訪問者だけにフォームを表示し、リードとして獲得します。</p>
    </div>
  </div>
</section>

<%= render "shared/form_for_visitor" if @current_form %>
