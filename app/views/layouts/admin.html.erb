<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} | Leadpulse" : "Leadpulse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <div class="flex min-h-screen">

      <%# ── Sidebar ── %>
      <aside class="w-56 bg-slate-900 flex flex-col fixed h-full z-40">
        <div class="px-5 py-4 border-b border-slate-800">
          <%= link_to admin_root_path, class: "flex items-center gap-2.5" do %>
            <div class="w-7 h-7 bg-sky-600 rounded-md flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
              </svg>
            </div>
            <div>
              <p class="text-white text-sm font-semibold leading-tight">Leadpulse</p>
              <p class="text-sky-400 text-xs leading-tight">Admin</p>
            </div>
          <% end %>
        </div>

        <nav class="flex-1 px-3 py-4 space-y-0.5">
          <%= link_to admin_root_path,
                class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150 #{current_page?(admin_root_path) ? 'bg-sky-700 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            ダッシュボード
          <% end %>

          <%= link_to admin_visitors_path,
                class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150 #{request.path.start_with?('/admin/visitors') ? 'bg-sky-700 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            訪問者
          <% end %>

          <%= link_to admin_leads_path,
                class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150 #{request.path.start_with?('/admin/leads') ? 'bg-sky-700 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            リード
          <% end %>
        </nav>

        <div class="px-3 py-4 border-t border-slate-800">
          <%= button_to session_path, method: :delete,
                form: { class: "w-full" },
                class: "w-full flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-white transition-colors duration-150 cursor-pointer" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            ログアウト
          <% end %>
        </div>
      </aside>

      <%# ── Main area ── %>
      <div class="ml-56 flex-1 flex flex-col min-h-screen">
        <header class="bg-white border-b border-slate-200 px-8 h-14 flex items-center">
          <h1 class="text-base font-semibold text-slate-900">
            <%= content_for?(:title) ? yield(:title) : "管理画面" %>
          </h1>
        </header>

        <% if flash[:alert] %>
          <div class="bg-red-50 border-b border-red-200 px-8 py-3 text-red-600 text-sm font-medium"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice] %>
          <div class="bg-sky-50 border-b border-sky-200 px-8 py-3 text-sky-700 text-sm font-medium"><%= flash[:notice] %></div>
        <% end %>

        <main class="flex-1 px-8 py-8">
          <%= yield %>
        </main>
      </div>

    </div>
  </body>
</html>
